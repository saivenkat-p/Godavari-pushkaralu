# Bandham QR - Environment Configuration Template
# Duplicate this file as .env (DO NOT COMMIT .env TO VERSION CONTROL)

# App & Server Settings
ENVIRONMENT=development
APP_SECRET_KEY=bandham-qr-dev-secret-key-change-in-production-2027
PORT=8001
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Settings (SQLite local, PostgreSQL supported for production)
DATABASE_URL=sqlite+aiosqlite:///./bandham_qr.db

# Official Meta WhatsApp Business Platform Cloud API Configuration
# Get these from Meta for Developers (https://developers.facebook.com) -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=bandham_pushkaralu_verify_token_2027
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v19.0

# Base URL for public QR links and webhooks (e.g., https://your-domain.com or ngrok URL)
PUBLIC_BASE_URL=http://localhost:5173

# Simulation Mode Settings
# If True, outbound WhatsApp messages are printed to log and simulated in the web simulator
SIMULATION_MODE=True
